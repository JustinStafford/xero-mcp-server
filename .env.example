# Xero API Configuration for Custom Connections
XERO_CLIENT_ID=your_client_id_here
XERO_CLIENT_SECRET=your_client_secret_here

# --- Standard OAuth 2.0 (multi-organisation) ---
# Set to "oauth" to use a standard OAuth 2.0 web app instead of a custom
# connection. One authorisation covers every organisation you consent to, and
# every tool call names its target organisation explicitly.
#
# Run `npm run authorise` once per organisation to connect them.
# XERO_AUTH_MODE=oauth

# Must exactly match a redirect URI registered on your Xero app.
# Not port 5000 on macOS: ControlCenter (AirPlay Receiver) binds it.
# XERO_REDIRECT_URI=http://localhost:8787/callback

# Where the refresh token is persisted. Defaults to ~/.xero-mcp/token.json
# XERO_TOKEN_FILE=/absolute/path/to/token.json
